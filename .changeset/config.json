{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "ignore": [
    "@nasti/web",
    "@nasti/common",
    "@nasti/ui",
    "@nasti/eslint-config",
    "@nasti/tailwind-config",
    "@nasti/typescript-config"
  ]
}
